OPENAI_API_KEY=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


# --- Optional (defaults shown) ---
OPENAI_MODEL=gpt-4o-mini
# For OpenAI-compatible providers (Groq, Ollama, Gemini...), set a base URL:
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# RAG / FAISS
EMBEDDING_PROVIDER=openai          # openai  or  local (free, offline TF-IDF)
EMBEDDING_MODEL=text-embedding-3-small
TOP_K=3                            # passages returned per search
# MIN_SIMILARITY=0.30              # raise if unrelated docs match; lower if real matches are missed

# Reliability
REQUEST_TIMEOUT=60                 # seconds per AI call
MAX_RETRIES=3                      # automatic retries on network / rate-limit errors
TICKET_TIMEOUT=180                 # seconds for the whole 4-agent run
MAX_MESSAGES=10                    # safety net for the agent conversation
TEMPERATURE=0.2
